{
  "name": "@mochinori/monorepo",
  "description": "mochinori: extensions and tools built on Lexical.",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"!@mochinori/website\" run build",
    "build-website": "pnpm --filter @mochinori/website run build",
    "start:website": "pnpm --filter @mochinori/website run start",
    "dev:website": "pnpm --filter @mochinori/website run dev",
    "deploy:website": "pnpm --filter @mochinori/website run deploy",
    "clean": "pnpm -r run clean",
    "tsc": "tsc",
    "tsc-website": "pnpm --filter @mochinori/website run tsc",
    "vitest": "vitest",
    "test-unit": "vitest --project unit --no-watch",
    "test-unit-watch": "vitest --project unit",
    "debug-test-unit": "vitest --inspect-brk --no-file-parallelism",
    "lint": "eslint ./",
    "lint:fix": "eslint ./ --fix",
    "prettier": "prettier --list-different .",
    "prettier:fix": "prettier --write .",
    "ci-check": "npm-run-all --parallel tsc tsc-website prettier lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.0",
    "@lexical/eslint-plugin": "catalog:",
    "@mochinori/eslint-plugin-internal": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "confusing-browser-globals": "^1.0.10",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-function-declare-after-return": "^1.1.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  },
  "browserslist": [
    "Chrome >= 86",
    "Firefox >= 115",
    "Safari >= 15",
    "Edge >= 86"
  ]
}
