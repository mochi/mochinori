{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "@cloudflare/workers-types"],
    "paths": {
      "void/routes": ["./.void/routes.d.ts"]
    }
  },
  "include": [
    "routes",
    "durable-objects",
    "crons",
    "server",
    "vite.config.ts",
    "void.config.ts",
    ".void/routes.d.ts"
  ]
}
