{
  "name": "@mochinori/cloudflare",
  "version": "0.0.0",
  "description": "Cloudflare infrastructure for mochinori, managed with alchemy.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mochinori/website run build && alchemy dev",
    "deploy": "pnpm --filter @mochinori/website run build && alchemy deploy",
    "destroy": "alchemy destroy",
    "tsc": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@mochinori/website": "workspace:*",
    "@types/node": "^24.0.0",
    "alchemy": "0.94.0",
    "typescript": "^6.0.3"
  }
}
